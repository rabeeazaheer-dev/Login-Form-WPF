<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="595" Width="1007" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize">
    <Grid Background="#1e1e2e">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#252539">
            <TextBlock Text="RABEEA" Foreground="#00d2ff" FontSize="26" 
                       FontWeight="Bold" Margin="0,30,0,30" HorizontalAlignment="Center"/>

            <Button Content="Home" Click="Home_Click" Height="45" Background="Transparent" Foreground="White" BorderThickness="0" Margin="15,5" Cursor="Hand"/>
            <Button Content="Products" Click="Products_Click" Height="45" Background="#00d2ff" Foreground="White" BorderThickness="0" Margin="15,5" Cursor="Hand"/>
            <Button Content="Settings" Click="Settings_Click" Height="45" Background="Transparent" Foreground="White" BorderThickness="0" Margin="15,5" Cursor="Hand"/>

            <TextBlock Text="Designed by Rabeea" Foreground="#444466" FontSize="12" Margin="0,220,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30">

            <StackPanel x:Name="HomeSection" Visibility="Collapsed">
                <TextBlock Text="Welcome, Rabeea!" Foreground="White" FontSize="32" FontWeight="SemiBold"/>
                <TextBlock Text="This is your Digital Gadgets Dashboard summary." Foreground="#64748b" Margin="0,10,0,0"/>
                <Border Background="#2d2d44" CornerRadius="10" Padding="20" Margin="0,30,0,0">
                    <TextBlock Text="Total Inventory: 5 Items" Foreground="#00d2ff" FontSize="20"/>
                </Border>
            </StackPanel>

            <StackPanel x:Name="ProductSection" Visibility="Visible">
                <TextBlock Text="Digital Gadgets Store" Foreground="White" FontSize="32" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,25,0,10">
                    <TextBlock Text="Search:" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBox x:Name="searchBar" Width="350" Height="35" Background="#2d2d44" Foreground="White" BorderBrush="#00d2ff" Padding="10,0" TextChanged="SearchBar_TextChanged"/>
                </StackPanel>
                <DataGrid x:Name="productGrid" Margin="0,20,0,0" AutoGenerateColumns="False" 
          Background="Transparent" RowBackground="Transparent" 
          Foreground="White" BorderThickness="0" GridLinesVisibility="None" 
          HeadersVisibility="Column" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ITEM NAME" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="150"/>
                        <DataGridTextColumn Header="PRICE" Binding="{Binding Price}" Width="100"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
